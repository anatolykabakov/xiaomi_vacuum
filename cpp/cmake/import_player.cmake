include_guard(GLOBAL)

include(ExternalProject)

# player-lib: pass absolute CMAKE_TOOLCHAIN_FILE.
set(_player_lib_cmake_toolchain_args "")
if(CMAKE_TOOLCHAIN_FILE)
  get_filename_component(
    _player_lib_toolchain_abs "${CMAKE_TOOLCHAIN_FILE}" ABSOLUTE
  )
  list(
    APPEND _player_lib_cmake_toolchain_args
    "-DCMAKE_TOOLCHAIN_FILE=${_player_lib_toolchain_abs}"
  )
endif()

string(
  CONCAT _player_patch_cmd "git reset --hard HEAD && git clean -fd && "
         "patch -p1 --batch < \"" "${CMAKE_CURRENT_LIST_DIR}/player.patch" "\""
)

ExternalProject_Add(
