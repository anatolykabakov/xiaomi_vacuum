set(XIAOMI_PLAYER_PREFIX "${CMAKE_CURRENT_BINARY_DIR}/player_external")
set(XIAOMI_PLAYER_LIB_DIR "${XIAOMI_PLAYER_PREFIX}/lib")
set(XIAOMI_PLAYER_CMAKE_MODULE_DIR
    "${XIAOMI_PLAYER_PREFIX}/share/cmake/Modules" CACHE PATH
    "Player CMake modules (UsePlayerC); optional CMAKE_MODULE_PATH entry"
)

# Static archives from `cmake --install` (BUILD_SHARED_LIBS=OFF on player-lib).
# Skip libplayerjpeg: needs HAVE_JPEG (often unset in cross/sysroot builds).
set(XIAOMI_PLAYER_STATIC_C
    "${XIAOMI_PLAYER_LIB_DIR}/libplayerc.a"
    "${XIAOMI_PLAYER_LIB_DIR}/libplayerinterface.a"
    "${XIAOMI_PLAYER_LIB_DIR}/libplayercommon.a"
    "${XIAOMI_PLAYER_LIB_DIR}/libplayerwkb.a"
)
set(XIAOMI_PLAYER_STATIC_LIBS "${XIAOMI_PLAYER_LIB_DIR}/libplayerc++.a"
    ${XIAOMI_PLAYER_STATIC_C}
)

# playerxdr in libplayerinterface.a uses Sun RPC XDR (libtirpc on Linux).
set(XIAOMI_PLAYER_UNIX_LIBS m z pthread)
if(UNIX)
  find_library(
    XIAOMI_PLAYER_TIRPC
    NAMES tirpc
  )
  if(XIAOMI_PLAYER_TIRPC)
    list(APPEND XIAOMI_PLAYER_UNIX_LIBS ${XIAOMI_PLAYER_TIRPC})
  else()
    message(
      WARNING
        "libtirpc not found (install libtirpc-dev). "
        "Linking Player clients will fail with undefined xdr_* references."
    )
  endif()
endif()

add_library(xiaomi_player_playercxx INTERFACE)
target_include_directories(
  xiaomi_player_playercxx
  INTERFACE "${XIAOMI_PLAYER_PREFIX}/include"
)
target_link_libraries(
  xiaomi_player_playercxx
  INTERFACE ${XIAOMI_PLAYER_STATIC_LIBS}
)
if(UNIX)
  target_link_libraries(
    xiaomi_player_playercxx
    INTERFACE ${XIAOMI_PLAYER_UNIX_LIBS}
  )
endif()

add_library(xiaomi_player_playerc INTERFACE)
target_include_directories(
  xiaomi_player_playerc
  INTERFACE "${XIAOMI_PLAYER_PREFIX}/include"
)
target_link_libraries(
  xiaomi_player_playerc
  INTERFACE ${XIAOMI_PLAYER_STATIC_C}
)
if(UNIX)
  target_link_libraries(
    xiaomi_player_playerc
    INTERFACE ${XIAOMI_PLAYER_UNIX_LIBS}
  )
endif()

add_library(xiaomi_player::playercxx ALIAS xiaomi_player_playercxx)
add_library(xiaomi_player::playerc ALIAS xiaomi_player_playerc)

add_dependencies(xiaomi_player_playercxx player-lib)
add_dependencies(xiaomi_player_playerc player-lib)

add_library(xiaomi_player_clients INTERFACE)
target_include_directories(
